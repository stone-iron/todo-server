<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.aloha.todo.mapper.TodoMapper">

    <!-- 목록: 등록 순서대로 가져오고, 페이지 안에서의 정렬(미완료 → 완료, 순서)은 서비스에서 처리 -->
    <select id="list" resultType="Todos">
        SELECT *
        FROM todos
        ORDER BY no ASC
    </select>

    <select id="select" resultType="Todos">
        SELECT *
        FROM todos
        WHERE no = #{no}
    </select>

    <select id="selectById" resultType="Todos">
        SELECT *
        FROM todos
        WHERE id = #{id}
    </select>

    <!-- 등록: 순서(seq)를 보내지 않으면 마지막 순서 + 1 -->
    <insert id="insert">
        INSERT INTO todos ( id, name, seq )
        SELECT #{id}, #{name}, COALESCE(#{seq}, IFNULL(MAX(seq), 0) + 1)
        FROM todos
    </insert>

    <update id="update">
        UPDATE todos
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="seq != null">seq = #{seq},</if>
            updated_at = now()
        </set>
        WHERE no = #{no}
    </update>

    <update id="updateById">
        UPDATE todos
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="status != null">status = #{status},</if>
            <if test="seq != null">seq = #{seq},</if>
            updated_at = now()
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM todos
        WHERE no = #{no}
    </delete>

    <delete id="deleteById">
        DELETE FROM todos
        WHERE id = #{id}
    </delete>

    <!-- 전체 완료 -->
    <update id="completeAll">
        UPDATE todos
        SET status = true,
            updated_at = now()
    </update>

    <!-- 전체 삭제 -->
    <delete id="deleteAll">
        DELETE FROM todos
    </delete>

</mapper>
